generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id               String  @id @default("default")
  email            String  @default("logosdev.agency@gmail.com")
  whatsapp         String  @default("393283634905")
  socialInstagram  String  @default("https://www.instagram.com/logosagency.dev/")
  socialLinkedin   String  @default("")
  socialFacebook   String  @default("")
  socialTiktok     String  @default("")
  legalName        String  @default("")
  legalAddress     String  @default("")
  legalVat         String  @default("")
  marqueeEnabled   Boolean @default(true)
  marqueeAutoplay  Boolean @default(true)
}

model Client {
  id             String    @id @default(cuid())
  name           String
  website        String?
  logoUrl        String?
  logoDarkUrl    String?
  isActive       Boolean   @default(true)
  showInMarquee  Boolean   @default(false)
  isFeatured     Boolean   @default(false)
  sortOrder      Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]
  images         MediaAsset[]
}

model Project {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category        String?
  shortDescription String?
  challenge       String?
  solution        String?
  services        String    @default("[]") // JSON array
  technologies    String    @default("[]") // JSON array
  externalUrl     String?
  coverUrl        String?
  status          String    @default("draft") // draft | published
  isFeatured      Boolean   @default(false)
  showInHome      Boolean   @default(true)
  showInCarousel  Boolean   @default(false)
  sortOrder       Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  images          MediaAsset[]
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int      @default(0)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String?
  message     String
  consent     Boolean  @default(false)
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
